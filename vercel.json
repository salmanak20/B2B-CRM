{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "stitch_crm_pro_enterprise_suite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "framework": "vite",
      "cleanUrls": false,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/login",
          "destination": "/crm_pro_enterprise/code.html"
        },
        {
          "source": "/dashboard",
          "destination": "/analytics_reports_crm_pro/code.html"
        },
        {
          "source": "/analytics",
          "destination": "/analytics_reports_crm_pro/code.html"
        },
        {
          "source": "/reports",
          "destination": "/analytics_reports_crm_pro/code.html"
        },
        {
          "source": "/companies",
          "destination": "/companies_crm_pro/code.html"
        },
        {
          "source": "/contacts",
          "destination": "/contacts_crm_pro/code.html"
        },
        {
          "source": "/leads",
          "destination": "/leads_management_crm_pro/code.html"
        },
        {
          "source": "/deals",
          "destination": "/workflow_automation_crm_pro/code.html"
        },
        {
          "source": "/tasks",
          "destination": "/tasks_activities_crm_pro/code.html"
        },
        {
          "source": "/notifications",
          "destination": "/notifications_crm_pro/code.html"
        },
        {
          "source": "/users",
          "destination": "/user_management_crm_pro/code.html"
        },
        {
          "source": "/settings",
          "destination": "/settings_crm_pro/code.html"
        },
        {
          "source": "/team",
          "destination": "/team_performance_crm_pro/code.html"
        },
        {
          "source": "/automations",
          "destination": "/automations_crm_pro/code.html"
        },
        {
          "source": "/calendar",
          "destination": "/calendar_crm_pro/code.html"
        },
        {
          "source": "/:path*/code",
          "destination": "/:path*/code.html"
        }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "same-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
            }
          ]
        }
      ],
      "installCommand": "npm ci --include=dev",
      "devCommand": "npm run dev -- --host 127.0.0.1"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "excludeFiles": "{.venv/**,.env,.env.*,tests/**,.backups/**,__pycache__/**,**/__pycache__/**,alembic/**,*.log}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
