APP_NAME=CRM Pro
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
CORS_ORIGINS=["https://b2-b-crm.vercel.app"]

# Local development:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/b2b_crm
#
# Supabase PostgreSQL:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_ENABLED_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=crm-attachments
FRONTEND_URL=https://b2-b-crm.vercel.app
COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
# Production desktop builds need explicit approval before using SameSite=None.
# If approved, keep COOKIE_SECURE=true and add https://tauri.localhost to CORS_ORIGINS.
SESSION_HOURS=8
REMEMBER_DAYS=30
ALLOW_SELF_REGISTRATION=false
LOGIN_RATE_LIMIT=10
RATE_WINDOW_SECONDS=900
# Serverless: due reminders are delivered on notification fetch.
DUE_NOTIFICATIONS_ENABLED=false
# Local-only development: ENVIRONMENT=development, AUTH_PROVIDER=legacy,
# COOKIE_SECURE=false, FRONTEND_URL=http://localhost:5173, matching local CORS_ORIGINS.

# Server only. Empty values keep Lemon Squeezy test billing disabled.
LEMON_SQUEEZY_TEST_ENABLED=
LEMON_SQUEEZY_TEST_API_KEY=
LEMON_SQUEEZY_TEST_STORE_ID=
LEMON_SQUEEZY_TEST_WEBHOOK_SECRET=
# JSON mapping: plan code -> product_id and variant_id strings. No prices here.
LEMON_SQUEEZY_TEST_PLAN_IDS=
LEMON_SQUEEZY_GRACE_DAYS=
