{
  "name": "stitch_crm_pro_enterprise_suite",
  "version": "1.0.0",
  "description": "B2B CRM Pro Enterprise Suite Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "vite --mode desktop",
    "build": "vite build",
    "desktop:build": "vite build --mode desktop",
    "check": "node scripts/check-shipped.mjs",
    "check:desktop": "node scripts/check-desktop-build.mjs",
    "tauri": "tauri",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "npm run desktop:build && playwright test --config=playwright.desktop.config.js",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.12.4",
    "axe-core": "^4.14.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "2.12.4"
  }
}
